# Railway Production Environment Variables for KS Mester AI Elite

# Server Port (Railway automatically sets PORT, defaults to 3000)
PORT=3000
NODE_ENV="production"

# Database connection URL (Automatically provided by Railway PostgreSQL plugin)
# Example: postgresql://postgres:password@containers-us-west-1.railway.app:5432/railway
DATABASE_URL="postgresql://user:password@host:port/database"

# Security & JWT Token Secret
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Gemini AI API Key (For AI SJA, Vision, and KS Analysis)
GEMINI_API_KEY="AIzaSy..."

# Supplier / Product API Keys (Optional)
NOBB_API_KEY=""
FIRECRAWL_API_KEY=""

# Application Domain
APP_URL="https://your-app.up.railway.app"
