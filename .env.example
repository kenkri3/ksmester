# ==============================================================================
# VikingMester - Railway & Produksjonsmiljøvariabler (.env.example)
# ==============================================================================

# 1. Database (PostgreSQL)
# Hvis du legger til en "PostgreSQL" plugin på Railway, settes denne automatisk.
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# 2. Autentisering & API-sikkerhet
# Generer en sikker, tilfeldig streng med f.eks: openssl rand -hex 32
# ⚠️ JWT_SECRET MÅ være satt i produksjon. Uten den genereres en tilfeldig
#    nøkkel per prosess, og alle brukere logges ut ved hver omstart.
JWT_SECRET=generer-en-sikker-og-lang-tilfeldig-streng-minimum-64-tegn-2026
INTERNAL_API_SECRET=generer-en-intern-api-hemmelighet-for-systemkall-2026
CRON_SECRET=generer-en-sikker-nokkel-for-github-actions-og-cron-2026

# 2b. Bot- og agentintegrasjoner (Botsify m.m.)
# ⚠️ PÅKREVD for at /api/agent/chat, /api/agent/email og
#    /api/openai/v1/chat/completions skal virke. Endepunktene feiler LUKKET
#    (401) dersom denne mangler.
# Brukes både som utgående bot-nøkkel mot Botsify og som innkommende
# plattformnøkkel for den OpenAI-kompatible broen.
# ⚠️ Den tidligere nøkkelen som lå hardkodet i kildekoden er kompromittert
#    (repoet har vært offentlig) og MÅ roteres i Botsify før den brukes her.
AGENT_API=din_botsify_bot_nokkel

# 2c. MCP-tjeneren (/api/mcp)
# ⚠️ PÅKREVD. Uten denne avvises ALLE MCP-kall (fail-closed).
# MCP-tjeneren eksponerer 23 verktøy, inkludert sletting og økonomidata,
# og skal derfor aldri stå åpen. Bruk en lang, tilfeldig verdi og send den som
# "Authorization: Bearer <verdi>" eller "x-api-key: <verdi>".
AGENT_MCP_SECRET_KEY=generer-en-lang-tilfeldig-mcp-hemmelighet

# Standard administrator-bruker (opprettes automatisk ved første oppstart)
ADMIN_EMAIL=kenkri3@gmail.com
ADMIN_PASSWORD=VelgEtSterktAdminPassord2026!

# 3. AI Mesterhjerne (1min.AI som hovedmotor, Google Gemini som backup)
# 1min.AI API-nøkkel hentes fra: https://1min.ai/
# Gir tilgang til OpenAI (gpt-4o-mini), Anthropic (claude-3-5-sonnet), Google (gemini-2.5-flash) med optimal kostnad og kvalitet
1_MIN_AI=ditt_1min_ai_api_key

# Sikkerhetsbackup 1 (Google Gemini): Hentes fra https://aistudio.google.com/app/apikey
# Aktiveres automatisk dersom 1min.AI er utilgjengelig eller mangler kreditter
GEMINI_API_KEY=AIzaSy_din_google_gemini_api_key

# Sikkerhetsbackup 2 (DeepSeek - valgfritt): Hentes fra https://platform.deepseek.com/api_keys
DEEP_SEEK_API=sk-ditt_deepseek_api_key

# 3c. PERSONOPPLYSNINGER: DeepSeek V4.1 Flash kjort i EU via Opper
# Hentes fra: https://platform.opper.ai/settings/api-keys
# Navnet DEEPSEEK_EU_API er det som er satt i Railway.
#
# Dette er motoren for ALL behandling som kan inneholde personopplysninger -
# kundenavn, adresse, e-post, telefon, ansatte, bilpark - og den brukes ogsa
# for bildeanalyse, siden DeepSeek V4.1 Flash er multimodal.
#
# Opper er en EU-hostet AI-gateway (AWS Stockholm), ISO/IEC 27001-sertifisert og
# GDPR-compliant, og oppgir at de ikke lagrer prompt eller svar med mindre en
# data retention-regel slar pa tracing.
#
# Koden pinner kallet til provider-kvalifiserte ruter som holder seg i EU:
#   tensorx/deepseek/deepseek-v4.1-flash   (TensorX, IE)
#   greenpt/deepseek-v4.1-flash            (GreenPT, NL)
#   melious/deepseek-v4.1-flash            (Melious, DE)
# Et BART modellnavn er samlet pa tvers av alle regioner og ma IKKE brukes her -
# da kan kallet hamne i USA. Rutene sference (EOS, leverandor GB) og nebius
# (GLOBAL service scope) er bevisst utelatt fordi kravet er EU, ikke EOS.
#
# Er denne satt, gar personopplysninger ALDRI til DeepSeek i Kina. Mangler den,
# faller stien tilbake til 1min.AI og Google Gemini EU, og feiler lukket hvis
# ingen av dem svarer.
#
# SAMME NOKKEL DEKKER OGSAA (alle i EU, ingen lagring av innholdet):
#   Tale-til-tekst : POST /api/ai/transcribe -> POST /v3/audio/transcriptions
#                    berget/NbAiLab/nb-whisper-large (Nasjonalbibliotekets
#                    norsk-trente Whisper, Sverige, $0.0022 per minutt lyd).
#                    Erstatter nettleserens webkitSpeechRecognition, som sender
#                    lyden til Google utenfor EU.
#   OCR            : POST /v3/ocr -> mistral/mistral-ocr-2512 (Frankrike,
#                    $0.0022 per side). Ikke bygget enna.
#   Embeddings     : POST /v3/compat/embeddings -> berget/intfloat/multilingual-e5-large
#                    (Sverige, $0.034 per 1M tokens). Ikke bygget enna.
#
# Se docs/opper-eu-analyse.md for priser, modellvalg og fallgruver.
DEEPSEEK_EU_API=ditt_opper_api_key

# 4. E-post Utsending (Resend)
# Hentes fra: https://resend.com/api-keys
RESEND_API_KEY=re_ditt_resend_api_key
EMAIL_FROM=VikingMester <varsel@vikingmester.no>

# 4b. Mottakere av interne varsler (nye leads, registreringer, integrasjoner)
# Komma-separert liste. Disse mottar KUNDEDATA (navn, e-post, telefon, org.nr),
# sa bruk firmadresser - ikke private kontoer. Er den ikke satt, gar varslene
# til hei@vikingmester.no.
# Eksempel: post@dittfirma.no,drift@dittfirma.no
ADMIN_NOTIFY_EMAILS=post@dittfirma.no

# 5. Filopplasting & Persistent Lagring
# Sti til persistent volum på Railway eller lokal disk
UPLOADS_PATH=/app/uploads

# 6. Domene, Nettverk & Miljø
APP_URL=https://vikingmester.no
NEXT_PUBLIC_APP_URL=https://vikingmester.no
NODE_ENV=production
PORT=3000

# 7. Valgfri Byggevare-database (Norsk Byggtjeneste NOBB)
# NOBB_API_KEY=din_nobb_api_nokkel

# 8. Autonom SEO & IndexNow
INDEXNOW_KEY=vikingmester-auto-seo-2026

# 9. Integrasjoner & Webhooks (Valgfritt)
# VIKINGCRM_WEBHOOK_URL=https://ditt-crm.no/webhook

# 10. Analyse (Google Analytics - Valgfritt)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
