# ==============================================================================
# KS MesterAI - Railway Produksjonsmiljøvariabler (.env.example)
# ==============================================================================

# 1. Database (PostgreSQL)
# Hvis du legger til en "PostgreSQL" plugin på Railway, legges denne til automatisk.
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# 2. Autentisering & Sikkerhet
JWT_SECRET=generer-en-sikker-og-lang-tilfeldig-streng-minimum-64-tegn-2026
ADMIN_EMAIL=kenkri3@gmail.com
ADMIN_PASSWORD=VelgEtSterktAdminPassord2026!

# 3. AI Mesterhjerne (DeepSeek API)
# Hentes fra: https://platform.deepseek.com/api_keys
DEEP_SEEK_API=sk-ditt_deepseek_api_key

# 4. E-post Utsending (Resend)
# Hentes fra: https://resend.com/api-keys
RESEND_API_KEY=re_ditt_resend_api_key
EMAIL_FROM=KS MesterAI <varsel@ksmester.no>

# 5. App, Domene & Cron Sikkerhet
APP_URL=https://ksmester.no
CRON_SECRET=generer-en-sikker-nokkel-for-github-actions-og-cron-2026
NODE_ENV=production
PORT=3000

# 6. Valgfri Byggevare-database (Norsk Byggtjeneste NOBB)
# NOBB_API_KEY=din_nobb_api_nokkel
